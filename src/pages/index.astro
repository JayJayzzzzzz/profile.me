---
import "../styles/global.css";
import "../styles/profile.css";
import "../styles/discord-profile.css";
import "../styles/panel.css";
import "../styles/extras.css";
import "../styles/cursor.css";
import ProfileCard from "../components/ProfileCard.astro";
import { GOATCOUNTER_CODE, OG_IMAGE_URL } from "../config";

const description = "JayJayzzzzzz — all my links in one place.";
const canonical = new URL("/", Astro.site).href;
// Dynamic live card if configured, otherwise the static build-time image.
const ogImage = OG_IMAGE_URL || new URL("og/index.png", Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Fallback icon; src/scripts/discord-avatar.ts swaps to the live Discord avatar. -->
    <link rel="icon" type="image/svg+xml" href="/avatar-fallback.svg" id="favicon" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#060606" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="JayJayzzzzzz" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="JayJayzzzzzz" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Roboto+Flex:opsz,wght@8..144,900&display=swap"
    />
    <title>JayJayzzzzzz</title>

    {
      GOATCOUNTER_CODE && (
        <script
          is:inline
          data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>

  <body>
    <main>
      <div id="rotating-image">
        <img
          id="avatar"
          src="/avatar-fallback.svg"
          alt="JayJayzzzzzz's profile picture"
          width="400"
          height="400"
          decoding="async"
        />
      </div>

      <ProfileCard />
    </main>

    <pre id="easter-egg" aria-hidden="true" hidden>{`   ∿∿∿  you found it  ∿∿∿
   ↑ ↑ ↓ ↓ ← → ← → B A
   hi, and thanks for poking around
   — Julian`}</pre>

    <!-- WebGL cursor trail: three.js (pinned), then the effect. Both are plain globals. -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/88/three.min.js"></script>
    <script is:inline src="/cursor-trail/effect.js"></script>

    <!-- Page behaviour, bundled by Astro from src/scripts/. -->
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
